<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The source of Sim i's own programs (user maintenance), put in QGPL at start-up. -->
    <EmbeddedResource Include="System\*" LogicalName="System/%(Filename)%(Extension)" />
    <!-- The web source editor's page. -->
    <EmbeddedResource Include="Web\*" LogicalName="Web/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
