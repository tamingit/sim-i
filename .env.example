# Sim i's settings: where it listens and who can sign on. Copy this file to .env and
# change what you need.
#
# Every server signs on against the users, which Sim i keeps in its database (the table
# QSIM_USER). The three users below are put in the table at each start, as written here; any
# other user in the table (System Options on the 5250 main menu maintains them) is kept as it is. A password changed
# through any server holds for all of them, and stays until the next start sets these three again.
#
# Sim i reads .env from the directory it starts in (or the file --env-file names). With Docker,
# pass it with --env-file .env. Variables set in the environment win over the file.
#
# Write values as they are, without quotes: Docker keeps quotes as part of the value.
# A user name is 1 to 10 characters: letters, digits, #, $, @ and _, not starting with a digit.
# Passwords are case-sensitive at password level 2 (the default). The 5250 sign-on screen takes
# up to 27 characters; the host servers take up to 128.

# ---- Where it listens ----
#
# The command line wins over these (--bind, --port, --print-port ...). A blank port, or a line
# left out or commented, means that server doesn't run. Docker's image sets its own addresses and
# ports on its command line, so these don't change them there: publish the ports with -p.

# The address to listen on: 127.0.0.1 for this machine only, 0.0.0.0 for every interface.
SIM_I_BIND=127.0.0.1

# 5250 Telnet, Network Print, sign-on, remote command, the file server and the port mapper, on IBM's own ports.
# The mapper's 449 and Telnet's TLS 992 are below 1024: outside Docker they need root or
# CAP_NET_BIND_SERVICE, so they're blank here, which leaves them off. Set them to 449 and 992
# when you can (clients that find the other ports through the mapper only look for it on 449).
SIM_I_PORT=2323
SIM_I_PRINT_PORT=8474
SIM_I_SIGNON_PORT=8476
SIM_I_COMMAND_PORT=8475
SIM_I_FILE_PORT=8473
SIM_I_MAPPER_PORT=

# The same servers over TLS. The certificate is made for each run, or, with SIM_I_TLS_CERT,
# kept in that PKCS #12 file (made when it's missing, with a .crt next to it for clients to
# trust). SIM_I_TLS_NAMES adds names or addresses to a certificate it makes, comma-separated.
SIM_I_TLS_PORT=
SIM_I_PRINT_TLS_PORT=9474
SIM_I_SIGNON_TLS_PORT=9476
SIM_I_COMMAND_TLS_PORT=9475
SIM_I_FILE_TLS_PORT=9473
SIM_I_TLS_CERT=
SIM_I_TLS_NAMES=

# ---- Libraries ----
#
# The PostgreSQL database Sim i keeps everything in: each library is a schema of it, with the
# library's source members, programs, display files and tables. QGPL's also holds the users and the
# spooled files. compose.yaml's postgres service is this one.
SIM_I_DATABASE=Host=127.0.0.1;Port=5432;Database=simi;Username=simi;Password=simi

# A folder of source, read at start-up: a folder for each library (MYLIB/QRPGLESRC/prog.rpgle, or
# MYLIB/prog.rpgle for the type's usual source file), and files directly in it go to QGPL. A library
# folder that isn't a library yet makes one. Each member that's new or changed is saved, checked and
# created. It has to exist; blank reads no source.
SIM_I_SOURCE_DIR=./source

# The folder that is the integrated file system's root ("/"): /COPY of a stream file, SRCSTMF,
# MKDIR, CPYTOSTMF and the IFS APIs RPG calls use it. Blank: a temporary one.
SIM_I_IFS_DIR=./ifs

# The web source editor's port: sign on with a user profile to edit, upload and compile source.
# Blank: no editor.
SIM_I_WEB_PORT=8080

# The debug server's port: VS Code, with the extension in vscode/sim-i, sets breakpoints in RPG,
# steps through it and shows its variables. A debugger signs on with a user profile. Blank: none.
SIM_I_DEBUG_PORT=4711

# ---- Receiving libraries from a real IBM i ----
#
# SAVRSTLIB and SAVRSTOBJ fetch a library, or some of its objects, from the system their RMTLOCNAME
# names, signing on to its FTP server as this user (who needs to read the objects). Set here, the
# password stays off the command line; RMTUSER and RMTPWD on a command win over these.
SIM_I_REMOTE_USER=
SIM_I_REMOTE_PASSWORD=

# ---- Users ----

# The user that signs on normally.
SIM_I_USER=PRTUSER
SIM_I_PASSWORD=Secret12

# A user whose password has expired. The right password gets "password has expired": the 5250
# sign-on screen goes on to a Change Password screen, and the sign-on server answers 0003000D
# until the password is changed through it.
SIM_I_EXPIRED_USER=EXPUSER
SIM_I_EXPIRED_PASSWORD=Expired1

# A user whose profile is disabled, as after too many wrong passwords. It can't sign on with
# any password: the 5250 sign-on screen says "User profile LOCKUSER cannot sign on", and the
# sign-on server answers 00020002.
SIM_I_LOCKED_USER=LOCKUSER
SIM_I_LOCKED_PASSWORD=Locked12
