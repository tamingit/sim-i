{
  "name": "sim-i",
  "displayName": "Sim i",
  "description": "Edit RPG in your repo, have each save compiled on Sim i, and debug it there: breakpoints, stepping, variables, watches.",
  "version": "0.1.0",
  "publisher": "sim-i",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onDebugResolve:sim-i"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rpgle",
        "aliases": [
          "RPGLE",
          "ILE RPG"
        ],
        "extensions": [
          ".rpgle",
          ".sqlrpgle",
          ".rpgleinc"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "rpgle"
      },
      {
        "language": "sqlrpgle"
      },
      {
        "language": "rpg"
      }
    ],
    "debuggers": [
      {
        "type": "sim-i",
        "label": "Sim i (RPG)",
        "languages": [
          "rpgle",
          "sqlrpgle",
          "rpg"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "The program to call: MYLIB/MYPGM or MYPGM. Left out, it's the program of the source file that's open."
              },
              "parms": {
                "type": "array",
                "description": "The parameters, as CALL passes them: text as characters, numbers as packed (15 5).",
                "items": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the program's first statement.",
                "default": false
              },
              "terminal": {
                "type": "boolean",
                "description": "Run the program in your 5250 session that waits at a command line (true), or in a job of its own with DSPLY in the debug console (false). Left out, a program with a display file runs in the session."
              },
              "host": {
                "type": "string",
                "description": "Sim i's host (default: the simI.host setting)."
              },
              "port": {
                "type": "number",
                "description": "Its debug port (default: the simI.debugPort setting)."
              },
              "user": {
                "type": "string",
                "description": "The user profile to sign on with (default: the simI.user setting)."
              },
              "sourceRoot": {
                "type": "string",
                "description": "The folder laid out LIBRARY/FILE/member.ext (default: the simI.sourceRoot setting, or the workspace folder)."
              }
            }
          },
          "attach": {
            "properties": {
              "jobUser": {
                "type": "string",
                "description": "Whose jobs stop at breakpoints: a user profile, or *ALL. Left out, the user signed on with: run the program in that user's 5250 session."
              },
              "host": {
                "type": "string",
                "description": "Sim i's host (default: the simI.host setting)."
              },
              "port": {
                "type": "number",
                "description": "Its debug port (default: the simI.debugPort setting)."
              },
              "user": {
                "type": "string",
                "description": "The user profile to sign on with (default: the simI.user setting)."
              },
              "sourceRoot": {
                "type": "string",
                "description": "The folder laid out LIBRARY/FILE/member.ext (default: the simI.sourceRoot setting, or the workspace folder)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "sim-i",
            "request": "launch",
            "name": "Sim i: call this program",
            "parms": []
          },
          {
            "type": "sim-i",
            "request": "attach",
            "name": "Sim i: attach to my 5250 session"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Sim i: call a program",
            "body": {
              "type": "sim-i",
              "request": "launch",
              "name": "Sim i: call ${1:MYLIB/MYPGM}",
              "program": "${1:MYLIB/MYPGM}",
              "parms": []
            }
          },
          {
            "label": "Sim i: attach to a user's jobs",
            "body": {
              "type": "sim-i",
              "request": "attach",
              "name": "Sim i: attach",
              "jobUser": "${1:*ALL}"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Sim i",
      "properties": {
        "simI.host": {
          "type": "string",
          "default": "localhost",
          "description": "Sim i's host name or address."
        },
        "simI.debugPort": {
          "type": "number",
          "default": 4711,
          "description": "Its debug port (--debug-port)."
        },
        "simI.webPort": {
          "type": "number",
          "default": 8080,
          "description": "Its web port (--web-port), which saved source is sent to."
        },
        "simI.user": {
          "type": "string",
          "default": "",
          "description": "The user profile to sign on with. The password is asked for once and kept in VS Code's secret storage."
        },
        "simI.sourceRoot": {
          "type": "string",
          "default": "",
          "description": "The folder laid out LIBRARY/FILE/member.ext, when it isn't the workspace folder: an absolute path, or one relative to the workspace folder."
        },
        "simI.uploadOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Send each source file to Sim i when it's saved: it's checked and compiled there, and what's found is listed under Problems."
        },
        "simI.problemsOnStart": {
          "type": "boolean",
          "default": true,
          "description": "When VS Code starts, list under Problems what Sim i last found in every source file of the workspace (when the sign-on is saved)."
        },
        "simI.remoteHost": {
          "type": "string",
          "default": "",
          "description": "The real IBM i that a program's files are copied from: its host name or address."
        },
        "simI.remoteUser": {
          "type": "string",
          "default": "",
          "description": "The user profile to sign on to the real IBM i with. The password is asked for once and kept in VS Code's secret storage."
        },
        "simI.remoteLibraries": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "The libraries on the real IBM i to look for a program's files in, in order."
        },
        "simI.siteUrl": {
          "type": "string",
          "default": "",
          "description": "The address Sim i's site has in the browser (https://sim-i.example.com), for opening the terminal, the profiles and Receive from here, and the terminal when a program with screens is debugged."
        }
      }
    },
    "commands": [
      {
        "command": "simI.programFiles",
        "title": "Sim i: Files of This Program",
        "icon": "$(database)"
      },
      {
        "command": "simI.uploadFile",
        "title": "Sim i: Send This File and Compile It"
      },
      {
        "command": "simI.allProblems",
        "title": "Sim i: Show Problems in All Files",
        "icon": "$(warning)"
      },
      {
        "command": "simI.uploadFolder",
        "title": "Sim i: Send a Folder and Compile It"
      },
      {
        "command": "simI.signOn",
        "title": "Sim i: Sign On (Change User or Password)"
      },
      {
        "command": "simI.openTerminal",
        "title": "Sim i: Open the Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "simI.openProfiles",
        "title": "Sim i: Open Program Profiles"
      },
      {
        "command": "simI.openReceive",
        "title": "Sim i: Receive a Library from an IBM i"
      },
      {
        "command": "simI.related.refresh",
        "title": "Sim i: Read the Related Files Again",
        "icon": "$(refresh)"
      },
      {
        "command": "simI.related.showUse",
        "title": "Go to Where It's Used Here",
        "icon": "$(selection)"
      },
      {
        "command": "simI.related.open",
        "title": "Sim i: Open a Related File"
      },
      {
        "command": "simI.copyData",
        "title": "Sim i: Copy Data from an IBM i",
        "icon": "$(cloud-download)"
      },
      {
        "command": "simI.files.find",
        "title": "Find Them on the IBM i",
        "category": "Sim i",
        "icon": "$(search)"
      },
      {
        "command": "simI.files.checkAll",
        "title": "Check Every File (to Copy Them All Again)",
        "category": "Sim i",
        "icon": "$(check-all)"
      },
      {
        "command": "simI.files.uncheckAll",
        "title": "Uncheck Every File",
        "category": "Sim i",
        "icon": "$(clear-all)"
      },
      {
        "command": "simI.files.copy",
        "title": "Copy the Checked Files to Sim i",
        "category": "Sim i",
        "icon": "$(cloud-download)"
      },
      {
        "command": "simI.files.withData",
        "title": "Copy Without Records (Click: With Them)",
        "category": "Sim i",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "simI.files.withoutData",
        "title": "Copy With Records (Click: Without Them)",
        "category": "Sim i",
        "icon": "$(record)"
      },
      {
        "command": "simI.files.cancel",
        "title": "End the Copy",
        "category": "Sim i",
        "icon": "$(debug-stop)"
      },
      {
        "command": "simI.files.refresh",
        "title": "Read the Program's Files Again",
        "category": "Sim i",
        "icon": "$(refresh)"
      },
      {
        "command": "simI.files.settings",
        "title": "IBM i Settings",
        "category": "Sim i",
        "icon": "$(gear)"
      },
      {
        "command": "simI.files.filter",
        "title": "Filter Its Records",
        "category": "Sim i",
        "icon": "$(edit)"
      },
      {
        "command": "simI.files.goto",
        "title": "Go to Where It's Declared",
        "category": "Sim i"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "simI.programFiles",
          "when": "resourceExtname =~ /\\.(rpgle|sqlrpgle)$/i",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "simI.copyData",
          "when": "view == simI.related",
          "group": "navigation@1"
        },
        {
          "command": "simI.related.refresh",
          "when": "view == simI.related",
          "group": "navigation@2"
        },
        {
          "command": "simI.openReceive",
          "when": "view == simI.related"
        },
        {
          "command": "simI.files.find",
          "when": "view == simI.files",
          "group": "navigation@1"
        },
        {
          "command": "simI.files.checkAll",
          "when": "view == simI.files && simI.files.remote && !simI.files.copying && !simI.files.allChecked",
          "group": "navigation@2"
        },
        {
          "command": "simI.files.uncheckAll",
          "when": "view == simI.files && simI.files.remote && !simI.files.copying && simI.files.allChecked",
          "group": "navigation@2"
        },
        {
          "command": "simI.files.copy",
          "when": "view == simI.files && simI.files.remote && !simI.files.copying",
          "group": "navigation@3"
        },
        {
          "command": "simI.files.withoutData",
          "when": "view == simI.files && simI.files.remote && simI.files.withData",
          "group": "navigation@4"
        },
        {
          "command": "simI.files.withData",
          "when": "view == simI.files && simI.files.remote && !simI.files.withData",
          "group": "navigation@4"
        },
        {
          "command": "simI.files.cancel",
          "when": "view == simI.files && simI.files.copying",
          "group": "navigation@5"
        },
        {
          "command": "simI.files.refresh",
          "when": "view == simI.files",
          "group": "navigation@6"
        },
        {
          "command": "simI.files.settings",
          "when": "view == simI.files"
        }
      ],
      "view/item/context": [
        {
          "command": "simI.related.showUse",
          "when": "view == simI.related && viewItem == simIRelatedUse",
          "group": "inline"
        },
        {
          "command": "simI.files.filter",
          "when": "view == simI.files && viewItem == simIFilter",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "simI.related.open",
          "when": "false"
        },
        {
          "command": "simI.related.showUse",
          "when": "false"
        },
        {
          "command": "simI.files.filter",
          "when": "false"
        },
        {
          "command": "simI.files.goto",
          "when": "false"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "simI.related",
          "name": "Related Files",
          "contextualTitle": "Sim i"
        }
      ],
      "simI": [
        {
          "id": "simI.files",
          "name": "Files of This Program",
          "contextualTitle": "Sim i"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "simI",
          "title": "Sim i",
          "icon": "media/files.svg"
        }
      ]
    }
  }
}
